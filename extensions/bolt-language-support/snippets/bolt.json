{
  "Page": {
    "prefix": "page",
    "body": [
      "page ${1:home}:",
      "\tshow \"${2:Hello}\" as title"
    ],
    "description": "A page (one per file; the name must match the file name)"
  },
  "Page with URL parameter": {
    "prefix": "pageparam",
    "body": [
      "page ${1:product}(${2:id}):",
      "\tfetch \"/api/${1:product}s/\" + ${2:id} into ${1:product}",
      "\tshow ${1:product}.${3:name} as title"
    ],
    "description": "Dynamic page: /product/:id"
  },
  "Component": {
    "prefix": "component",
    "body": [
      "component ${1:Card} for ${2:item}:",
      "\tshow ${2:item}.${3:name}"
    ],
    "description": "A reusable component with one prop"
  },
  "Component with props": {
    "prefix": "componenttakes",
    "body": [
      "component ${1:Card} takes ${2:title}:",
      "\tcolumn:",
      "\t\tshow ${2:title} as subtitle",
      "\t\tslot"
    ],
    "description": "A wrapper component: content placed inside it goes into the slot"
  },
  "Wrapper block": {
    "prefix": "wrap",
    "body": [
      "${1:Card} with ${2:title}=\"${3:Hello}\":",
      "\t$0"
    ],
    "description": "Use a component and put content inside it"
  },
  "Store": {
    "prefix": "store",
    "body": "store ${1:count} = ${2:0}",
    "description": "Local state"
  },
  "Remember": {
    "prefix": "remember",
    "body": "remember ${1:name} = \"${2:}\"",
    "description": "State saved in the browser"
  },
  "Global store": {
    "prefix": "globalstore",
    "body": "global store ${1:cart} = []",
    "description": "State shared by all pages"
  },
  "Button": {
    "prefix": "button",
    "body": [
      "button \"${1:Save}\":",
      "\t$0"
    ],
    "description": "A button with actions"
  },
  "Form": {
    "prefix": "form",
    "body": [
      "form:",
      "\tinput \"${1:Email}\" into ${2:email}:",
      "\t\trequired",
      "\t\temail",
      "\tsubmit \"${3:Send}\":",
      "\t\tshow toast \"${4:Done}\" as success"
    ],
    "description": "A form with validation (input state is created for you)"
  },
  "Input": {
    "prefix": "input",
    "body": "input \"${1:Name}\" into ${2:name}",
    "description": "A text field; the variable is created automatically"
  },
  "Fetch": {
    "prefix": "fetch",
    "body": [
      "fetch \"${1:/api/items}\" into ${2:items}",
      "show all ${2:items}"
    ],
    "description": "Load data (loading and error messages are built in)"
  },
  "Fetch with blocks": {
    "prefix": "fetchfull",
    "body": [
      "fetch \"${1:/api/items}\" into ${2:items}:",
      "\tloading:",
      "\t\tshow \"Loading...\"",
      "\terror err:",
      "\t\tshow \"Something went wrong\"",
      "\tempty:",
      "\t\tshow \"Nothing here yet\"",
      "\tsuccess:",
      "\t\tshow all ${2:items}"
    ],
    "description": "Load data with your own loading, error and empty messages"
  },
  "Resource": {
    "prefix": "resource",
    "body": [
      "resource ${1:products} at \"/api/${1:products}\":",
      "\t${2:title} text required",
      "\t${3:price} number"
    ],
    "description": "One block = list page + add form + delete (and a built-in API)"
  },
  "Styles": {
    "prefix": "styles",
    "body": [
      "styles:",
      "\t${1:card}: ${2:bg-surface border border-line rounded-2xl p-6}"
    ],
    "description": "Named Tailwind class sets, usable anywhere"
  },
  "Styled as": {
    "prefix": "styled",
    "body": "styled as: ${1:card}",
    "description": "Add Tailwind classes or style names"
  },
  "Layout": {
    "prefix": "layout",
    "body": [
      "layout:",
      "\tshow ${1:Navbar}",
      "\tslot",
      "\tshow ${2:Footer}"
    ],
    "description": "Wraps every page. slot = where the page goes"
  },
  "No layout": {
    "prefix": "layoutnone",
    "body": "layout none",
    "description": "Inside a page: do not use the project layout"
  },
  "Design system": {
    "prefix": "design",
    "body": [
      "design system:",
      "\tthemes:",
      "\t\tlight:",
      "\t\t\tbackground: \"#ffffff\"",
      "\t\t\tink: \"#0f172a\"",
      "\t\t\tbrand: \"#2563eb\"",
      "\t\tdark:",
      "\t\t\tbackground: \"#0b1220\"",
      "\t\t\tink: \"#f1f5f9\"",
      "\t\t\tbrand: \"#3b82f6\""
    ],
    "description": "Light and dark theme colors (become bg-brand, text-ink ...)"
  },
  "Theme toggle": {
    "prefix": "themetoggle",
    "body": [
      "button \"Toggle dark mode\":",
      "\tif theme == \"dark\":",
      "\t\ttheme = \"light\"",
      "\totherwise:",
      "\t\ttheme = \"dark\""
    ],
    "description": "Switch between light and dark"
  },
  "Use file": {
    "prefix": "use",
    "body": "use ${1:helpers}",
    "description": "Import a file by name from anywhere in the project"
  },
  "If / otherwise": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "\t$2",
      "otherwise:",
      "\t$0"
    ],
    "description": "Condition"
  },
  "If logged in": {
    "prefix": "iflogged",
    "body": [
      "if logged in:",
      "\t$1",
      "otherwise:",
      "\t$0"
    ],
    "description": "Show something only to signed-in users"
  },
  "For every": {
    "prefix": "forevery",
    "body": [
      "for every ${1:item} in ${2:items}:",
      "\t$0"
    ],
    "description": "Repeat the content for each item"
  },
  "Show all": {
    "prefix": "showall",
    "body": "show all ${1:items}",
    "description": "Draw one component per item (matched by name)"
  },
  "When changes": {
    "prefix": "when",
    "body": [
      "when ${1:query} changes:",
      "\t$0"
    ],
    "description": "Run something when a value changes"
  },
  "Action": {
    "prefix": "action",
    "body": [
      "action ${1:calculateTotal}:",
      "\tgive ${2:0}"
    ],
    "description": "Reusable logic that can give a value back"
  },
  "Toast": {
    "prefix": "toast",
    "body": "show toast \"${1:Saved}\" as ${2|success,danger,info|}",
    "description": "A small message"
  },
  "Go to": {
    "prefix": "goto",
    "body": "go to ${1:home}",
    "description": "Open another page"
  },
  "Link": {
    "prefix": "link",
    "body": "link \"${1:Home}\" to ${2:home}",
    "description": "A link to a page"
  },
  "Endpoint": {
    "prefix": "endpoint",
    "body": [
      "endpoint ${1|get,post,put,patch,delete|} \"/api/${2:search}\":",
      "\tq = request.query.${3:q}",
      "\tgive data.${4:products} filtered by p: contains p.${5:title}, q"
    ],
    "description": "A custom API route (runs on the built-in server)"
  },
  "Endpoint reply": {
    "prefix": "reply",
    "body": "reply ${1:404}, \"${2:Not found}\"",
    "description": "Stop an endpoint with an error status"
  }
}