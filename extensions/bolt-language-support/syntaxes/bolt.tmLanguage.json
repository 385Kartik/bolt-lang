{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bolt",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.bolt"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.bolt" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.bolt" }
          },
          "name": "string.quoted.double.bolt",
          "patterns": [
            {
              "include": "#interpolations"
            }
          ]
        }
      ]
    },
    "interpolations": {
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.bolt" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.bolt" }
          },
          "name": "meta.template.expression.bolt",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(page|component|for|store|remember|when|changes|show|all|each|in|button|link|input|if|otherwise|repeat|times|from|to|until|every|give|print|and|or|not|styled|as|row|column|grid|auto|card|hero|section|container|primary|secondary)\\b",
          "name": "keyword.control.bolt"
        },
        {
          "match": "\\b(as|to)\\b",
          "name": "keyword.operator.bolt"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.bolt"
        },
        {
          "match": "\\b(null|undefined)\\b",
          "name": "constant.language.null.bolt"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+(\\.\\d+)?\\b",
          "name": "constant.numeric.bolt"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "==|!=|>=|<=|>|<|\\+|-|\\*|/|%|=",
          "name": "keyword.operator.bolt"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.readwrite.bolt"
        }
      ]
    }
  },
  "scopeName": "source.bolt"
}
