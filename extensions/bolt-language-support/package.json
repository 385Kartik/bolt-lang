{
  "name": "bolt-language-support",
  "displayName": "Bolt Language Support",
  "description": "Syntax colors, snippets, suggestions and live problem checking for the Bolt language",
  "version": "1.4.0",
  "publisher": "bolt-framework",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/385Kartik/bolt-lang" },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:bolt"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bolt",
        "aliases": ["Bolt", "bolt"],
        "extensions": [".bolt"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "bolt",
        "scopeName": "source.bolt",
        "path": "./syntaxes/bolt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bolt",
        "path": "./snippets/bolt.json"
      }
    ],
    "commands": [
      { "command": "bolt.check", "title": "Bolt: Check Project" },
      { "command": "bolt.stats", "title": "Bolt: Show Size Report (Bolt vs React)" }
    ],
    "configuration": {
      "title": "Bolt",
      "properties": {
        "bolt.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check the whole project for problems every time you save a .bolt file."
        },
        "bolt.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bolt command (for example C:/projects/bolt-lang/cli/bolt.js). Leave empty to find it automatically."
        }
      }
    }
  }
}
